if SOC_SERIES_HYDROGEN

config RISCV_SOC_INTERRUPT_INIT
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 52

config NUM_IRQS
	default 32

config XIP
	default y

config USE_DT_CODE_PARTITION
	default y

# syscon provides the reference clock for the clock controller, so it must
# initialize before CLOCK_CONTROL_INIT_PRIORITY (KERNEL_INIT_PRIORITY_OBJECTS).
config SYSCON_INIT_PRIORITY
	default 20

endif # SOC_SERIES_HYDROGEN
